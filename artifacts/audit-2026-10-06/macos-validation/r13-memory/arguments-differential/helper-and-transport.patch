@@ -1,4 +1,5 @@
 #if IOS
+using Foundation;
 using WebKit;
 #endif
 
@@ -20,4 +21,24 @@
         return await _web.EvaluateJavaScriptAsync(script);
 #endif
     }
+
+    private async Task<string?> CallRendererCallbackAsync(string callback, string payload)
+    {
+#if IOS
+        if (_web.Handler?.PlatformView is not WKWebView webView)
+            throw new InvalidOperationException("The editor is not ready.");
+
+        using var callbackKey = new NSString("callback");
+        using var payloadKey = new NSString("payload");
+        using var callbackValue = new NSString(callback);
+        using var payloadValue = new NSString(payload);
+        using var arguments = new NSDictionary<NSString, NSObject>(
+            [callbackKey, payloadKey], [callbackValue, payloadValue]);
+        using var result = await webView.CallAsyncJavaScriptAsync(
+            "return window[callback]?.(payload);", arguments, null, WKContentWorld.Page);
+        return result?.ToString();
+#else
+        return await EvaluateScriptAsync($"window.{callback}?.('{payload}')");
+#endif
+    }
 }
