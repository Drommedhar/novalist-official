+// TEMPORARY M02 COUNTERS. Do not ship.
+using Foundation;
+namespace Novalist.Mobile.Services;
+public static partial class SecurityScopedFolders
+{
+    private static int _auditStarts, _auditStartFailures, _auditStops, _auditStopCompleted;
+    private static int _auditPickerArmed, _auditPickerCallbacks, _auditPickerResumed;
+    private static TaskCompletionSource? _auditPickerGate;
+    private static bool AuditStart(NSUrl url)
+    {
+        var started = url.StartAccessingSecurityScopedResource();
+        if (started) Interlocked.Increment(ref _auditStarts);
+        else Interlocked.Increment(ref _auditStartFailures);
+        return started;
+    }
+    private static void AuditStop(NSUrl url)
+    {
+        Interlocked.Increment(ref _auditStops);
+        url.StopAccessingSecurityScopedResource();
+        Interlocked.Increment(ref _auditStopCompleted);
+    }
+    private static void AuditStopOptional(NSUrl? url) { if (url != null) AuditStop(url); }
+    public static void AuditArmPicker() => Interlocked.Exchange(ref _auditPickerArmed, 1);
+    public static bool AuditReleasePicker() => _auditPickerGate?.TrySetResult() == true;
+    private static async Task AuditDelayPickerAsync()
+    {
+        Interlocked.Increment(ref _auditPickerCallbacks);
+        if (Interlocked.Exchange(ref _auditPickerArmed, 0) == 0) return;
+        var gate = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        _auditPickerGate = gate;
+        await gate.Task;
+        Interlocked.Increment(ref _auditPickerResumed);
+    }
+    public static object AuditScopeState()
+    {
+        lock (Gate) return new {
+            successfulStarts = _auditStarts, failedStarts = _auditStartFailures,
+            stopCalls = _auditStops, completedStops = _auditStopCompleted,
+            retainedFolders = Active.Count, pickerCallbacks = _auditPickerCallbacks,
+            pickerHeld = _auditPickerGate is { Task.IsCompleted: false },
+            pickerResumed = _auditPickerResumed
+        };
+    }
+}
