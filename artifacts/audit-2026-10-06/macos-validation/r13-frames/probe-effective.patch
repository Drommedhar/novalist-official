+// TEMPORARY AUDIT INSTRUMENTATION. Never include in a shipped application.
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using Microsoft.Maui.ApplicationModel;
+using Foundation;
