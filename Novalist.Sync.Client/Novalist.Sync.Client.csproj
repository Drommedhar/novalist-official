<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableSteamworks Condition="'$(EnableSteamworks)' == ''">false</EnableSteamworks>
    <DefineConstants Condition="'$(EnableSteamworks)' == 'true'">$(DefineConstants);NOVALIST_STEAMWORKS</DefineConstants>
    <EnableLoopbackSignIn Condition="'$(EnableLoopbackSignIn)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('ios'))">false</EnableLoopbackSignIn>
    <EnableLoopbackSignIn Condition="'$(EnableLoopbackSignIn)' == ''">true</EnableLoopbackSignIn>
    <DefineConstants Condition="'$(EnableLoopbackSignIn)' == 'true'">$(DefineConstants);NOVALIST_LOOPBACK_SIGNIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Novalist.Sync.Client.Tests" />
    <Compile Include="..\Novalist.Core\Utilities\LegacyEntityIdentities.cs" Link="Storage\LegacyEntityIdentities.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(EnableLoopbackSignIn)' == 'true'" />
    <Compile Remove="LoopbackSignIn.cs" Condition="'$(EnableLoopbackSignIn)' != 'true'" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.13" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSteamworks)' == 'true'">
    <ProjectReference Include="../eng/SteamworksBinding/SteamworksBinding.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSteamworks)' == 'true' and Exists('$(SteamworksNativeLibrary)')">
    <Content Include="$(SteamworksNativeLibrary)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireSteamworksNativeLibrary" BeforeTargets="PrepareForBuild;GetCopyToPublishDirectoryItems" Condition="'$(EnableSteamworks)' == 'true'">
    <Error Condition="!Exists('$(SteamworksNativeLibrary)')" Text="Steam builds require SteamworksNativeLibrary pointing to the SDK 1.65 redistributable. On Windows use eng/Build-CollaborationSteam.ps1; see docs/development/steam-collaboration.md." />
  </Target>
</Project>
