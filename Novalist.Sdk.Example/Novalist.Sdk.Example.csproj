<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="extension.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Locales\*.json" CopyToOutputDirectory="PreserveNewest" Link="Locales\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novalist.Sdk\Novalist.Sdk.csproj" />
  </ItemGroup>
  <Target Name="DeployExtension" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <ExtensionDeployDir>$(APPDATA)\Novalist\Extensions\Sample</ExtensionDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionDeployDir)\Locales" />
    <Copy SourceFiles="$(OutputPath)Novalist.Sdk.Example.dll;$(OutputPath)Novalist.Sdk.dll;$(OutputPath)extension.json" DestinationFolder="$(ExtensionDeployDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_LocaleFiles Include="$(OutputPath)Locales\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LocaleFiles)" DestinationFolder="$(ExtensionDeployDir)\Locales" SkipUnchangedFiles="true" />
  </Target>
</Project>
