<Project>
  <!-- SDK targets finalize IntermediateOutputPath (configuration/framework/RID)
       after this file is imported. Resolve native outputs at execution time. -->
  <Target Name="ConfigureMacSpeech" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(TargetFramework)' == 'net8.0' and '$(BuildAppleDesktopSpeech)' != 'false'">
    <PropertyGroup>
      <_SpeechArch>arm64</_SpeechArch>
      <_SpeechArch Condition="'$(RuntimeIdentifier)' == 'osx-x64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64')">x86_64</_SpeechArch>
      <_SpeechLibrary>$(IntermediateOutputPath)apple-speech/$(_SpeechArch)/libNovalistSpeech.dylib</_SpeechLibrary>
    </PropertyGroup>
  </Target>
  <Target Name="BuildMacSpeech" BeforeTargets="CopyFilesToOutputDirectory" DependsOnTargets="ConfigureMacSpeech"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(TargetFramework)' == 'net8.0' and '$(BuildAppleDesktopSpeech)' != 'false'"
          Inputs="$(MSBuildThisFileDirectory)NovalistSpeech.swift;$(MSBuildThisFileDirectory)AppleMicrophone.swift;$(MSBuildThisFileDirectory)build.sh" Outputs="$(_SpeechLibrary)">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)build.sh&quot; macos $(_SpeechArch) &quot;$(_SpeechLibrary)&quot;" />
  </Target>
  <Target Name="CopyMacSpeech" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="BuildMacSpeech"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(TargetFramework)' == 'net8.0' and '$(BuildAppleDesktopSpeech)' != 'false'">
    <Copy SourceFiles="$(_SpeechLibrary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishMacSpeech" AfterTargets="Publish" DependsOnTargets="BuildMacSpeech"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(TargetFramework)' == 'net8.0' and '$(BuildAppleDesktopSpeech)' != 'false'">
    <Copy SourceFiles="$(_SpeechLibrary)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
