<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == '' and $([MSBuild]::IsOSPlatform('osx'))">net10.0-ios27.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiVersion>10.0.110</MauiVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novalist.Mobile</RootNamespace>

    <!-- App identity.
         The bundle ID deliberately matches the desktop/Mac App Store appId in
         app/electron-builder.yml. An App Store Connect record is keyed to a
         single bundle ID across every platform it carries, so sharing the ID is
         what lets iOS ship as a platform of the existing macOS app record
         (universal purchase) instead of a second, separate app. Do not "fix"
         this to a mobile-specific ID — that would split the record in two. -->
    <ApplicationTitle>Novalist</ApplicationTitle>
    <ApplicationId>com.novalist.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">27.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">33.0</SupportedOSPlatformVersion>

    <!--
      Novalist.Backend is OutputType=Exe (the desktop stdio host). We reference it
      only for its BackendHost + Rpc facade types, hosted in-process here. Allow a
      self-contained iOS app to reference the non-self-contained exe.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
    <Compile Remove="Services\AppFolders.cs;Services\IosFileAccessCoordinator.cs;Services\IosStoredPathResolver.cs;Services\SecurityScopedFolders*.cs;Services\ImagePicking.cs;Services\ExportSharing.cs;Services\SystemMicrophone.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon: the real Novalist icon (shared with the Electron build). iOS
         icons must be opaque, so Color flattens the artwork's transparent corners
         to match its dark border. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#00060f" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0a1420" BaseSize="200,200" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core and Sdk arrive transitively through Backend. Keep a single build
         path: MAUI publish adjusts reference properties, and redundant direct
         references can compile the same output concurrently. -->
    <!-- The local import server uses the desktop ASP.NET Core runtime. -->
    <ProjectReference Include="..\Novalist.Backend\Novalist.Backend.csproj" AdditionalProperties="BuildAppleDesktopSpeech=false;EnableImportApi=false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- In-process transport: the same seam the backend tests drive. -->
    <PackageReference Include="Nerdbank.Streams" Version="2.13.16" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <!--
    Editor spike assets. Include the editor and its local sanitizer directly
    from the renderer so the spike uses the same content handling as the app.
    LogicalName places them under the "editor" root that EditorSpikePage's
    HybridWebView loads from when validating typing, caret, and selection.
  -->
  <ItemGroup>
    <MauiAsset Include="..\app\src\renderer\public\editor\editor.html">
      <LogicalName>editor\editor.html</LogicalName>
    </MauiAsset>
    <MauiAsset Include="..\app\src\renderer\public\editor\*.js">
      <LogicalName>editor\%(Filename)%(Extension)</LogicalName>
    </MauiAsset>
  </ItemGroup>

  <!--
    The renderer bundle (Phase 1) produced by `npm run build:mobile` into
    Resources/Raw/app. Included explicitly (rather than relying on the implicit
    Resources/Raw glob, which misses this freshly-generated folder due to
    evaluation-time caching) so RendererHostPage's HybridWebView (HybridRoot="app")
    always finds index.mobile.html + assets. Remove the default Raw glob for this
    subtree to avoid duplicate MauiAsset items.
  -->
  <ItemGroup>
    <MauiAsset Remove="Resources\Raw\app\**\*" />
    <MauiAsset Include="Resources\Raw\app\**\*" LogicalName="app\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="../native/AppleSpeech/AppleSpeech.iOS.targets" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
</Project>
