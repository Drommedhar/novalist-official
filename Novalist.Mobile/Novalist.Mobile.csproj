<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Novalist.Mobile - Phase 0 spike (iOS first).
    Deliberately NOT added to novalist-official.sln: the desktop/CI build and the
    100%-coverage gate (Core/Sdk/Backend) must stay untouched. Build this project
    on its own with `dotnet build Novalist.Mobile/Novalist.Mobile.csproj`.

    Requires (installed by the developer, see docs/mobile-phase0-runbook.md):
      - full Xcode.app (not just Command Line Tools)
      - `sudo dotnet workload install maui-ios`
  -->

  <PropertyGroup>
    <!-- iOS first for the spike. Add net10.0-android here in Phase 0's Android half. -->
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novalist.Mobile</RootNamespace>

    <!-- App identity -->
    <ApplicationTitle>Novalist</ApplicationTitle>
    <ApplicationId>com.novalist.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!--
      Novalist.Backend is OutputType=Exe (the desktop stdio host). We reference it
      only for its BackendHost + Rpc facade types, hosted in-process here. Allow a
      self-contained iOS app to reference the non-self-contained exe.
    -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: the real Novalist icon (shared with the Electron build). iOS
         icons must be opaque, so Color flattens the artwork's transparent corners
         to match its dark border. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0a1420" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1e1e2e" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# core and RPC facades ship unchanged (the reuse win). -->
    <ProjectReference Include="..\Novalist.Core\Novalist.Core.csproj" />
    <ProjectReference Include="..\Novalist.Backend\Novalist.Backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process transport: the same seam the backend tests drive. -->
    <PackageReference Include="Nerdbank.Streams" Version="2.13.16" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <!--
    Editor spike asset. The contenteditable editor is a single self-contained
    HTML file; include it directly from the renderer (single source of truth) at
    the HybridWebView root path so we can load it on a real device and validate
    typing, caret, and selection. LogicalName places it under the "editor" root
    that EditorSpikePage's HybridWebView loads from.
  -->
  <ItemGroup>
    <MauiAsset Include="..\app\src\renderer\public\editor\editor.html">
      <LogicalName>editor\editor.html</LogicalName>
    </MauiAsset>
  </ItemGroup>

  <!--
    The renderer bundle (Phase 1) produced by `npm run build:mobile` into
    Resources/Raw/app. Included explicitly (rather than relying on the implicit
    Resources/Raw glob, which misses this freshly-generated folder due to
    evaluation-time caching) so RendererHostPage's HybridWebView (HybridRoot="app")
    always finds index.mobile.html + assets. Remove the default Raw glob for this
    subtree to avoid duplicate MauiAsset items.
  -->
  <ItemGroup>
    <MauiAsset Remove="Resources\Raw\app\**\*" />
    <MauiAsset Include="Resources\Raw\app\**\*" LogicalName="app\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
