<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export-compliance declaration, so App Store Connect / TestFlight never
	     prompts per build. false = only exempt encryption (standard HTTPS and
	     OS-provided crypto); no custom cryptography. Mirrors the desktop app's
	     `extendInfo` in app/electron-builder.yml — same codebase, same answer.
	     Revisit if Novalist ever ships proprietary encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Novalist keeps a folder of its own in the Files app ("On My iPhone ->
	     Novalist"), which is where new projects go unless the writer picks
	     somewhere else. Two reasons it is worth the two keys: a project there is
	     visible to the writer, to iCloud backup and to any app they want to sync
	     it with; and it is readable without a security-scoped grant, so the
	     recent-projects list still works on the first launch after an update.
	     LSSupportsOpeningDocumentsInPlace is what makes the folder editable in
	     place rather than something Files copies in and out. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
