{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Novalist Backend (Debug)",
      "detail": "Builds the C# core the new Electron UI spawns as a child process.",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Novalist.Backend/Novalist.Backend.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build collaboration renderer",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "prepare collaboration desktop",
      "dependsOn": ["build Novalist Backend (Debug)", "build collaboration renderer"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "prepare collaboration server",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/eng/Prepare-CollaborationServer.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "build collaboration Steam backend",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/eng/Build-CollaborationSteam.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "build collaboration Steam renderer",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build:steam"],
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": []
    },
    {
      "label": "prepare collaboration Steam app",
      "dependsOn": ["build collaboration Steam backend", "build collaboration Steam renderer"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "install New UI deps",
      "detail": "npm install for the Electron app (run once after cloning).",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "problemMatcher": []
    }
  ]
}
