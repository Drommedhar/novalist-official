{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "New UI: Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "runtimeExecutable": "${workspaceFolder}/app/node_modules/.bin/electron-vite",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/app/node_modules/.bin/electron-vite.cmd"
      },
      "runtimeArgs": ["dev", "--sourcemap"],
      "console": "integratedTerminal",
      "preLaunchTask": "build Novalist Backend (Debug)",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/app/**",
        "!**/node_modules/**"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": null,
        "REMOTE_DEBUGGING_PORT": "9222",
        // Force the version the update check treats as "installed". Set to an
        // older version (e.g. "1.0.0") to make the app detect the latest GitHub
        // release as an update and exercise the self-update flow. Empty = use the
        // real build version (no forcing).
        "NOVALIST_FORCE_VERSION": ""
      }
    },
    {
      "name": "New UI: Renderer Process",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "timeout": 60000,
      "webRoot": "${workspaceFolder}/app/src/renderer",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/app/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "New UI: Attach to Backend (C#)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "New UI: Full Stack (main + renderer)",
      "configurations": ["New UI: Main Process", "New UI: Renderer Process"],
      "stopAll": true
    }
  ]
}
