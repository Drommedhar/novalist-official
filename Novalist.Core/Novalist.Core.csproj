<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Novalist.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scene-analysis keyword lists, one JSON per writing language. Embedded so
         adding a language needs no packaging change - drop in a new file. -->
    <!-- WithCulture=false: MSBuild would otherwise read the ".en"/".de" segment as
         a culture and push these into satellite assemblies. LogicalName pins the
         name the loader looks up. -->
    <EmbeddedResource Include="Resources/Analysis/*.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Novalist.Core.Resources.Analysis.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novalist.Sdk\Novalist.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

</Project>
