<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Novalist.Core.Tests" />
    <InternalsVisibleTo Include="Novalist.Backend" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scene-analysis keyword lists, one JSON per writing language. Embedded so
         adding a language needs no packaging change - drop in a new file. -->
    <!-- WithCulture=false: MSBuild would otherwise read the ".en"/".de" segment as
         a culture and push these into satellite assemblies. LogicalName pins the
         name the loader looks up. -->
    <EmbeddedResource Include="Resources/Analysis/*.json">
      <WithCulture>false</WithCulture>
      <LogicalName>Novalist.Core.Resources.Analysis.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novalist.Sdk\Novalist.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp's minimum PKCS version predates the October 2026 security fixes. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
  </ItemGroup>

</Project>
