<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NuGet restore ignores ProjectReference.AdditionalProperties. Use the
         requested RID too, so iOS restore never imports the desktop web runtime. -->
    <EnableImportApi Condition="'$(EnableImportApi)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('ios'))">false</EnableImportApi>
    <EnableImportApi Condition="'$(EnableImportApi)' == ''">true</EnableImportApi>
    <DefineConstants Condition="'$(EnableImportApi)' == 'true'">$(DefineConstants);NOVALIST_IMPORT_API</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableImportApi)' == 'true'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Novalist.Backend.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novalist.Core\Novalist.Core.csproj" />
    <ProjectReference Include="..\Novalist.Sdk\Novalist.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <!-- Shipped so extensions built against the desktop host's MVVM toolkit (their
         ViewModels derive from CommunityToolkit.Mvvm's ObservableObject) can resolve
         it from the backend's app base. Without it, ExtensionLoadContext delegates
         the "CommunityToolkit" host prefix to the default context, which cannot find
         the assembly, and Assembly.GetTypes() throws during extension load. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <Import Project="../native/AppleSpeech/AppleSpeech.Mac.targets" />
</Project>
